        "text": "= {{ $json.title }}__{{ $json.link }}",
        "options": {
          "systemMessage": "=নিচের সরকারি notice বাংলায় সংক্ষেপে বুঝিয়ে বলো। \nশিরোনাম: {{ $json.title }}\nলিংক: {{ $json.link }}\n\nযদি ২০২৬ সাল নিয়ে না হই তাহলে কোণ বার্তা দিবে না\n\nতুমি সরকারি notice-এর সহকারী। দেওয়া শিরোনাম বাংলায় সংক্ষেপে বুঝিয়ে বলো: কোর্সের নাম, কারা আবেদন করতে পারবে, সময়, আবেদনের শেষ তারিখ, ফ্রি কিনা।\nযা শিরোনামে নেই তা \"বিস্তারিত notice-এ দেখুন\" লিখবে, নিজে থেকে বানাবে না।\nসবশেষে লিংকটা দেবে।"
        }
