    {
      "parameters": {
        "jsCode": "const base = 'https://moysports.gov.bd/pages/notices';\nconst d = $input.first().json;\nconst titles = d.titles || [];\nconst links = d.links || [];\nconst keywords = ['বিনামূল্যে', 'ফ্রি', 'প্রশিক্ষণ', 'কোর্স', 'free', 'training', 'course'];\n\nconst out = [];\ntitles.forEach((t, i) => {\n  const title = (t || '').trim();\n  let link = links[i] || '';\n  if (link.startsWith('/')) link = base + link;   // relative link কে full link বানানো\n  const hit = keywords.some(k => title.toLowerCase().includes(k.toLowerCase()));\n  if (hit && link) out.push({ json: { title, link } });\n});\nreturn out;"
      },
